# Firebase Admin SDK (required for all /api/* routes except /api/desmosKey)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# AI grading keys (optional — users can supply their own per-request)
GEMINI_API_KEY=
CLAUDE_API_KEY=

# Desmos graphing calculator (optional — also settable in sync-config.js)
DESMOS_API_KEY=

# Server port (default 8888)
PORT=8888
