          "correct": false
        },
        {
          "text": "B. Analogue: Continuous (varying) signal, more susceptible to signal degradation; Digital: Discrete (binary) signal, less susceptible to signal degradation",
          "correct": true
        },
        {
          "text": "C. Analogue: Discrete (binary) signal, less susceptible to signal degradation; Digital: Continuous (varying) signal, more susceptible to signal degradation",
          "correct": false
        },
        {
          "text": "D. Analogue: Discrete (binary) signal, more susceptible to signal degradation; Digital: Continuous (varying) signal, less susceptible to signal degradation",
          "correct": false
        }
      ],
      "answerTable": {
        "caption": "Analogue and digital communications",
        "columns": [
          "Analogue",
          "Digital"
        ],
        "rows": [
          [
