          ],
          [
            "Continuous (varying) signal\nMore susceptible to signal degradation",
            "Discrete (binary) signal\nLess susceptible to signal degradation"
          ],
          [
            "Discrete (binary) signal\nLess susceptible to signal degradation",
            "Continuous (varying) signal\nMore susceptible to signal degradation"
          ],
          [
            "Discrete (binary) signal\nMore susceptible to signal degradation",
            "Continuous (varying) signal\nLess susceptible to signal degradation"
          ]
        ]
      }
