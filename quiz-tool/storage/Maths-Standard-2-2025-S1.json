    {
      "id": "math2025-s2-q10",
      "name": "Question 10",
      "question": "An electricity company charges customers 37 cents per kWh for electricity used, U, and pays customers 5 cents per kWh for electricity produced, P. The electricity company also charges customers a fee of 71 cents per day. Which formula should be used to calculate a customer’s daily cost of electricity, in cents?",
      "sourcePaper": "https://www.nsw.gov.au/sites/default/files/noindex/2025-10/2025-hsc-maths-standard-2.pdf",
      "sourceMarking": "https://www.nsw.gov.au/sites/default/files/noindex/2025-11/2025-hsc-maths-standard-2-mg.pdf",
      "sourcePack": "https://www.nsw.gov.au/education-and-training/nesa/curriculum/hsc-exam-papers/mathematics-standard/2025",
      "sourceYear": 2025,
      "isMultipleChoice": true,
      "isCheckbox": false,
      "answers": [
        {
          "text": "C = 71 + 37U − 5P",
          "correct": true
        },
        {
          "text": "C = 71 + 37U + 5P",
          "correct": false
        },
        {
          "text": "C = 71 − 37U − 5P",
          "correct": false
        },
        {
          "text": "C = 71 − 37U + 5P",
          "correct": false
        }
      ]
    },
