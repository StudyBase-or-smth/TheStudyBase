[Unit]
Description=StudyBase local sync
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/StudyBaseData
Environment=PORT=8787
Environment=STUDYBASE_PUBLIC_URL=http://basecomputer.tail8c20e2.ts.net:8787
ExecStart=%h/.local/node/bin/node %h/StudyBaseData/server.js
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
